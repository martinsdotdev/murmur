---
/**
 * Runs synchronously before paint; shared so it stays byte-identical.
 *
 * It also keeps <meta name="theme-color"> honest. A static value would be wrong
 * for half of visitors, and three separate places write data-theme (this file,
 * ThemeToggle, and applyTheme in lib/theme.ts), so the meta follows the
 * attribute rather than each writer. The two colours live on the meta element
 * itself, because the landing page and the app are not the same surface.
 *
 * The same observer switches transitions off for the frame the theme changes
 * in. Left on, anything that transitions colour fades for 150ms while the rest
 * of the page snaps, and the switch arrives as a visible stagger.
 *
 * It also restores the app's colour scheme and pure black night (lib/theme.ts)
 * before paint, so a Sky user never sees a frame of Amber. The landing page's
 * stylesheet doesn't read either attribute. Where a stylesheet defines
 * --theme-color (the app's, which follows both), the meta takes that instead
 * of its own fixed pair, re-read once the page has loaded. A scheme's value
 * is an oklch(from …) expression, which a custom property hands back
 * unresolved, so it's painted to a pixel and read back as a hex.
 */
---

<script is:inline>
  ;(function () {
    const root = document.documentElement
    const meta = document.querySelector('meta[name="theme-color"]')
    const probe = document.createElement("i")
    probe.style.cssText = "display:none;color:var(--theme-color)"
    const pixel = document
      .createElement("canvas")
      .getContext("2d", { willReadFrequently: true })
    const themeColor = () => {
      const token = getComputedStyle(root).getPropertyValue("--theme-color")
      if (!token.trim() || !document.body || !pixel) return ""
      document.body.append(probe)
      pixel.fillStyle = getComputedStyle(probe).color
      probe.remove()
      pixel.fillRect(0, 0, 1, 1)
      const [r, g, b] = pixel.getImageData(0, 0, 1, 1).data
      return (
        "#" + [r, g, b].map((v) => v.toString(16).padStart(2, "0")).join("")
      )
    }
    const paint = () => {
      if (!meta) return
      const value = themeColor() || meta.dataset[root.dataset.theme || "dark"]
      if (value) meta.setAttribute("content", value)
    }

    try {
      // SCHEMES in lib/theme.ts, less Amber, which is no attribute at all.
      const scheme = localStorage.getItem("scheme")
      if (["rose", "sage", "sky", "violet"].includes(scheme)) {
        root.dataset.scheme = scheme
      }
      if (localStorage.getItem("night") === "black")
        root.dataset.night = "black"
    } catch {}

    let resolved = null
    try {
      const stored = localStorage.getItem("theme")
      if (stored === "light" || stored === "dark") resolved = stored
    } catch {}
    if (!resolved) {
      resolved = window.matchMedia("(prefers-color-scheme: light)").matches
        ? "light"
        : "dark"
    }

    root.dataset.theme = resolved
    paint()

    const freeze = document.createElement("style")
    freeze.textContent = "*,*::before,*::after{transition:none!important}"
    new MutationObserver(() => {
      document.head.appendChild(freeze)
      // Forces the new colours to apply while transitions are off, so the
      // removal below has nothing left to animate.
      void document.body.offsetHeight
      setTimeout(() => freeze.remove())
      paint()
    }).observe(root, {
      attributeFilter: ["data-theme", "data-scheme", "data-night"],
    })
    window.addEventListener("load", paint)
  })()
</script>
