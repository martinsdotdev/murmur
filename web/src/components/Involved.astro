---
import { repoUrl, issuesUrl, sponsorUrl } from "../data/site.ts"

const cards = [
  {
    href: repoUrl,
    title: "Contribute",
    body: "The code is on GitHub. Pull requests welcome.",
  },
  {
    href: issuesUrl,
    title: "Give feedback",
    body: "Report a bug or suggest a sound on the issue tracker.",
  },
  {
    href: sponsorUrl,
    title: "Support the project",
    body: "Chip in for the hosting.",
  },
]
---

<section class="involved" id="involved" aria-labelledby="involved-heading">
  <div class="container">
    <h2 id="involved-heading" class="section-h2 involved-heading">
      Get involved
    </h2>
    <div class="involved-grid">
      {
        cards.map((c) => (
          <a href={c.href} class="involved-card" target="_blank" rel="noopener">
            <span class="involved-title">{c.title}</span>
            <span class="involved-body">{c.body}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .involved {
    border-top: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
  }

  .involved-heading {
    margin-bottom: var(--space-xxl);
  }

  .involved-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-m);
  }

  .involved-card {
    display: block;
    padding: 20px 22px;
    background: var(--color-neutral-background-2);
    border: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
    border-radius: var(--border-radius-large);
    color: var(--color-neutral-foreground-1);
    /* box-shadow deliberately not transitioned: shadow interpolation repaints
       every frame; --shadow-2 is subtle enough to snap in. */
    transition:
      border-color var(--duration-fast) var(--curve-easy-ease),
      background-color var(--duration-fast) var(--curve-easy-ease),
      transform var(--duration-fast) var(--curve-decelerate-mid);
  }

  .involved-card:hover {
    background: var(--color-neutral-background-3);
    border-color: var(--color-neutral-stroke-1);
    color: var(--color-neutral-foreground-1);
    text-decoration: none;
  }

  /* Movement stays behind a real pointer: touch fires sticky :hover on tap. */
  @media (hover: hover) and (pointer: fine) {
    .involved-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-2);
    }

    .involved-card:active {
      transform: translateY(0);
    }
  }

  .involved-title {
    display: block;
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-xs);
  }

  .involved-body {
    display: block;
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-neutral-foreground-2);
  }
</style>
