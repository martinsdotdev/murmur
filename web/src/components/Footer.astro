---
import { sounds } from "../data/sounds.ts"
import BrandLogo from "./BrandLogo.astro"
import { repoUrl, releasesUrl, issuesUrl, blanketUrl } from "../data/site.ts"
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-mark">
          <BrandLogo size={22} />
          <span class="footer-mark-text">Murmur</span>
        </div>
        <p class="footer-blurb">
          Murmur is a free, open-source ambient sound mixer for Windows.
        </p>
        <div class="footer-links">
          <a href={repoUrl} target="_blank" rel="noopener">GitHub</a>
          <a href={releasesUrl} target="_blank" rel="noopener">Releases</a>
          <a href={issuesUrl} target="_blank" rel="noopener">Issues</a>
          <a
            href={`${repoUrl}/blob/master/Murmur/Sounds/SOUNDS_LICENSING.md`}
            target="_blank"
            rel="noopener">Sound licenses</a
          >
        </div>
      </div>

      <div class="footer-attr" id="credits">
        <h3 class="attr-heading">Sound attribution</h3>
        <div class="attr-grid">
          {
            sounds.map((s) => (
              <div class="attr-row">
                <span class="attr-name">{s.name}</span>
                <span class="attr-leader" aria-hidden="true" />
                <span class="attr-author">{s.attribution.author}</span>
                <a
                  href={s.attribution.sourceUrl}
                  target="_blank"
                  rel="noopener"
                  class="attr-license"
                >
                  {s.attribution.license}
                </a>
              </div>
            ))
          }
        </div>
        {
          /* The licences above are the artists' own; this credits the project
            that gathered them into one set. */
        }
        <p class="attr-note">
          Sound set assembled by <a
            href={blanketUrl}
            target="_blank"
            rel="noopener">Blanket</a
          >.
        </p>
      </div>
    </div>

    <p class="footer-base">GPLv3 · No telemetry, no account, no ads</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
    padding-block: 56px 40px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: start;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .footer-mark {
    display: flex;
    align-items: center;
    gap: var(--space-sn);
    margin-bottom: 14px;
  }

  .footer-mark-text {
    font-family: var(--font-family-serif);
    font-size: 17px;
    font-weight: var(--font-weight-regular);
    color: var(--color-neutral-foreground-1);
  }

  .footer-blurb {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-neutral-foreground-2);
    max-width: 42ch;
    margin-bottom: 18px;
  }

  .footer-links {
    display: flex;
    gap: 18px;
    font-size: 12.5px;
    flex-wrap: wrap;
  }

  .attr-heading {
    font-family: var(--font-family-base);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neutral-foreground-3);
    margin-bottom: var(--space-m);
  }

  .attr-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 24px;
  }

  @media (max-width: 700px) {
    .attr-grid {
      grid-template-columns: 1fr;
    }
  }

  .attr-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    font-size: var(--font-caption1-size);
    padding: 3px 0;
    min-width: 0;
  }

  .attr-name {
    color: var(--color-neutral-foreground-1);
    white-space: nowrap;
  }

  .attr-leader {
    flex: 1;
    border-bottom: 1px dotted var(--color-neutral-stroke-1);
    min-width: 12px;
  }

  .attr-author {
    color: var(--color-neutral-foreground-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .attr-license {
    white-space: nowrap;
    font-size: 11.5px;
  }

  .attr-note {
    margin-top: var(--space-m);
    font-size: 11.5px;
    color: var(--color-neutral-foreground-3);
  }

  .footer-base {
    font-size: 11.5px;
    color: var(--color-neutral-foreground-3);
    margin-top: 40px;
    padding-top: 18px;
    border-top: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
    max-width: none;
  }
</style>
