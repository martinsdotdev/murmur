---
import { repoUrl, releasesUrl, latestReleaseApi } from "../data/site.ts"
import Icon from "./Icon.astro"
import { Download04Icon } from "@hugeicons/core-free-icons"
import { m } from "@/paraglide/messages.js"
import { around } from "@/lib/i18n"

interface Release {
  tag_name: string
  html_url: string
}

let release: Release | null = null
try {
  const res = await fetch(latestReleaseApi, {
    headers: { Accept: "application/vnd.github+json" },
  })
  if (res.ok) release = (await res.json()) as Release
} catch {
  // Offline build / API rate limited, fall through to placeholder.
}

const [soonBefore, soonAfter] = around(m.download_soon, "link")
const [grabBefore, grabAfter] = around(m.cert_download_body, "file")
const [runBefore, runAfter] = around(m.cert_run_body, "file")
---

<section class="download" id="download" aria-labelledby="download-heading">
  <div class="download-grid container">
    <div class="download-pitch">
      <h2 id="download-heading" class="section-h2">{m.download_heading()}</h2>
      <p class="download-reqs">{m.download_reqs()}</p>
      <a
        href={release?.html_url ?? releasesUrl}
        class="btn btn-primary btn-large"
        target="_blank"
        rel="noopener"
      >
        <Icon icon={Download04Icon} size={17} />
        {m.download_latest()}
      </a>
      {
        /* Kept on one line: inside an expression a line break between the
          halves and the link becomes a space, which Japanese doesn't use. */
      }
      {
        !release &&
          // prettier-ignore
          <p class="download-soon">{soonBefore}<a href={repoUrl} target="_blank" rel="noopener">{m.download_soon_link()}</a>{soonAfter}</p>
      }
    </div>

    <div class="cert-card">
      <p class="cert-lead">{m.cert_lead()}</p>
      <ol class="cert-steps">
        <li>
          <strong>{m.cert_download_title()}</strong>
          <p>{grabBefore}<code>Murmur.cer</code>{grabAfter}</p>
        </li>
        <li>
          <strong>{m.cert_trust_title()}</strong>
          <p>{m.cert_trust_body()}</p>
        </li>
        <li>
          <strong>{m.cert_run_title()}</strong>
          <p>{runBefore}<code>.msixbundle</code>{runAfter}</p>
        </li>
      </ol>
      <p class="cert-note">{m.cert_note()}</p>
    </div>
  </div>
</section>

<style>
  .download {
    border-top: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
  }

  .download-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: start;
  }

  @media (max-width: 960px) {
    .download-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .download-pitch h2 {
  }

  .download-reqs {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-neutral-foreground-2);
    max-width: 40ch;
    margin-bottom: 26px;
  }

  .download-soon {
    font-size: 13px;
    color: var(--color-neutral-foreground-3);
    margin-top: var(--space-mn);
  }

  .cert-card {
    background: var(--color-neutral-background-2);
    border: var(--stroke-width-thin) solid var(--color-neutral-stroke-1);
    border-radius: 14px;
    padding: 26px 28px;
  }

  .cert-lead {
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-neutral-foreground-1);
    margin-bottom: var(--space-l);
    max-width: none;
  }

  /* The list numbers itself. What used to sit here were digits typed by hand
     into an ordered list and then marked aria-hidden, because they said
     nothing the <ol> had not already said, and they would have gone stale the
     first time a step was inserted. The count still matters, since the last
     step refers back to the first two, so it stays as plain type rather than
     as badges. */
  .cert-steps {
    padding-left: 1.6em;
  }

  .cert-steps li::marker {
    color: var(--color-neutral-foreground-3);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .cert-steps li + li {
    margin-top: var(--space-mn);
  }

  .cert-steps strong {
    display: block;
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-neutral-foreground-1);
    margin-bottom: 3px;
  }

  .cert-steps p {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-neutral-foreground-2);
  }

  .cert-steps code {
    font-family: var(--font-family-mono);
    font-size: var(--font-caption1-size);
    background: var(--color-neutral-background-3);
    padding: 1px 5px;
    border-radius: var(--border-radius-small);
  }

  .cert-note {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-neutral-foreground-3);
    margin-top: var(--space-l);
    padding-top: var(--space-mn);
    border-top: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
  }
</style>
