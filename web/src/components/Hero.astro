---
import BrandLogo from "./BrandLogo.astro"
import Icon from "./Icon.astro"
import { Download04Icon, PlayIcon } from "@hugeicons/core-free-icons"
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"
import { m } from "@/paraglide/messages.js"
import { getLocale } from "@/paraglide/runtime.js"

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "")

// <locale>-<theme>.png, taken by scripts/screenshots.mjs.
const shots = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>(
      "../assets/screenshots/*.png",
      { eager: true }
    )
  ).map(([path, mod]) => [path.split("/").pop()!.slice(0, -4), mod.default])
)
---

<header class="hero" id="top" aria-labelledby="hero-heading">
  <div class="hero-inner container">
    <BrandLogo size={72} rise />

    <h1 id="hero-heading" class="serif-display hero-title">Murmur</h1>

    <p class="hero-sub">{m.hero_sub()}</p>

    <div class="hero-ctas">
      <a href={`${baseUrl}/`} class="btn btn-primary btn-large hero-mix">
        <span class="hero-mix-icon" aria-hidden="true">
          <Icon icon={PlayIcon} size={17} />
          <span class="hero-mix-meter"><i></i><i></i><i></i></span>
        </span>
        {m.hero_try()}
      </a>
      <a href="#download" class="btn btn-secondary btn-large">
        <Icon icon={Download04Icon} size={17} />
        {m.hero_download()}
      </a>
    </div>

    <p class="hero-meta">{m.hero_meta()}</p>

    <div class="hero-shot">
      {
        (["light", "dark"] as const).map((theme) => (
          <Picture
            src={shots[`${getLocale()}-${theme}`]}
            formats={["avif", "webp"]}
            widths={[640, 1280, 1920]}
            sizes="(min-width: 1040px) 960px, calc(100vw - 48px)"
            alt={m.hero_screenshot_alt()}
            class={`hero-shot-${theme}`}
            loading="lazy"
            decoding="async"
          />
        ))
      }
    </div>
  </div>
</header>

<style>
  /* An app page, not a pitch: the mark identifies the thing, the name is the
     heading, one line says what it does, and a screenshot shows the real
     mixer. No decorative gradients, and no device frame around it. */
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(56px, 9vw, 96px) clamp(48px, 8vw, 80px);
  }

  .hero-title {
    margin: 22px 0 0;
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-neutral-foreground-2);
    max-width: 46ch;
    margin: 14px 0 0;
    /* balance, not pretty: a short centred block wants even line lengths.
       pretty only protects the last line, which leaves the ones above it
       running full width against a centred axis. */
    text-wrap: balance;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 30px;
  }

  /* The page's one loud control, in the app's own terms: the sheen its filled
     buttons carry, a highlight along the top edge and a shadow in the button's
     own amber. Hovered, the play triangle becomes the level meter a playing
     card shows, which is what pressing it starts. */
  .hero-mix {
    background-image: linear-gradient(
      135deg,
      oklch(from var(--color-brand-fill) l c h / 0) 20%,
      oklch(
        from var(--color-brand-fill) calc(l + 0.04) calc(c + 0.03)
          calc(h - 25) / 0.9
      )
    );
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.24),
      0 1px 2px oklch(from var(--color-brand-fill) calc(l - 0.35) c h / 0.35),
      0 8px 20px -8px oklch(from var(--color-brand-fill) l c h / 0.6);
    transition:
      background-color 150ms ease,
      box-shadow 200ms var(--curve-decelerate-mid),
      transform 160ms var(--curve-decelerate-mid);
  }

  .hero-mix:active {
    transform: scale(0.97);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.16),
      0 1px 2px oklch(from var(--color-brand-fill) calc(l - 0.35) c h / 0.35);
    transition-duration: 100ms;
  }

  .hero-mix-icon {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
  }

  .hero-mix-icon > :global(*) {
    grid-area: 1 / 1;
    transition:
      opacity 150ms ease,
      transform 200ms var(--curve-decelerate-mid);
  }

  .hero-mix-meter {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
    opacity: 0;
    transform: scale(0.6);
  }

  .hero-mix-meter i {
    width: 3px;
    height: 100%;
    border-radius: 9999px;
    background: currentColor;
    transform-origin: bottom;
    animation: hero-mix-eq 0.9s ease-in-out infinite paused;
  }

  /* The app's meter timings, so it moves as a playing card's does. */
  .hero-mix-meter i:nth-child(2) {
    animation-duration: 1.2s;
    animation-delay: -0.3s;
  }

  .hero-mix-meter i:nth-child(3) {
    animation-duration: 0.7s;
    animation-delay: -0.6s;
  }

  .hero-mix:is(:hover, :focus-visible) .hero-mix-icon > :global(svg) {
    opacity: 0;
    transform: scale(0.6);
  }

  .hero-mix:is(:hover, :focus-visible) .hero-mix-meter {
    opacity: 1;
    transform: scale(1);
  }

  .hero-mix:is(:hover, :focus-visible) .hero-mix-meter i {
    animation-play-state: running;
  }

  /* A real pointer only: a tap fires a hover that sticks. */
  @media (hover: hover) and (pointer: fine) {
    .hero-mix:hover {
      transform: translateY(-1px);
      box-shadow:
        inset 0 1px 0 oklch(100% 0 0 / 0.24),
        0 1px 2px oklch(from var(--color-brand-fill) calc(l - 0.35) c h / 0.35),
        0 12px 28px -10px oklch(from var(--color-brand-fill) l c h / 0.7);
    }

    .hero-mix:hover:active {
      transform: scale(0.97);
    }
  }

  @keyframes hero-mix-eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* Reduced motion keeps the swap as a fade and the bars still. */
  @media (prefers-reduced-motion: reduce) {
    .hero-mix,
    .hero-mix:hover,
    .hero-mix:active,
    .hero-mix:hover:active,
    .hero-mix-icon > :global(*) {
      transform: none !important;
    }

    .hero-mix-meter i {
      animation: none;
      transform: scaleY(0.6);
    }

    .hero-mix-meter i:nth-child(2) {
      transform: scaleY(0.9);
    }
  }

  .hero-meta {
    font-size: 13px;
    color: var(--color-neutral-foreground-3);
    margin-top: 22px;
  }

  /* The theme's own shot. Both are lazy, so the hidden one is never fetched. */
  .hero-shot {
    width: 100%;
    max-width: 960px;
    margin-top: clamp(40px, 6vw, 64px);
  }

  .hero-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
    border-radius: var(--border-radius-large);
  }

  :global([data-theme="dark"]) .hero-shot :global(.hero-shot-light),
  :global([data-theme="light"]) .hero-shot :global(.hero-shot-dark) {
    display: none;
  }

  @media (max-width: 560px) {
    .hero-ctas {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
