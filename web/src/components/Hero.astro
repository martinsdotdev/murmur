---
import BrandLogo from "./BrandLogo.astro"
import Icon from "./Icon.astro"
import Message from "./Message.astro"
import { Download04Icon, PlayIcon } from "@hugeicons/core-free-icons"
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"
import { repoUrl } from "../data/site.ts"
import { m } from "@/paraglide/messages.js"
import { getLocale } from "@/paraglide/runtime.js"

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "")

// <locale>-<theme>.png, taken by scripts/screenshots.mjs.
const files = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>(
      "../assets/screenshots/*.png",
      { eager: true }
    )
  ).map(([path, mod]) => [path.split("/").pop()!.slice(0, -4), mod.default])
)

/** One theme's picture, as AVIF and WebP sets and a WebP fallback. */
async function shot(theme: "light" | "dark") {
  const src = files[`${getLocale()}-${theme}`]
  const widths = [640, 960, 1280, 1920]
  const set = (format: "avif" | "webp") =>
    getImage({ src, widths, format }).then((i) => i.srcSet.attribute)
  return {
    theme,
    avif: await set("avif"),
    webp: await set("webp"),
    fallback: await getImage({ src, width: 1280, format: "webp" }),
  }
}
const shots = await Promise.all([shot("light"), shot("dark")])
const sizes =
  "(min-width: 1440px) 1080px, (min-width: 1040px) 960px, calc(100vw - 40px)"
---

<header class="hero" id="top" aria-labelledby="hero-heading">
  <div class="hero-inner container">
    <BrandLogo size={56} rise decorative />

    <h1 id="hero-heading" class="serif-display hero-title">Murmur</h1>

    <p class="hero-sub">{m.hero_sub()}</p>

    <div class="hero-ctas">
      <a href={`${baseUrl}/`} class="btn btn-primary btn-large hero-mix">
        <span class="hero-mix-icon" aria-hidden="true">
          <Icon icon={PlayIcon} size={17} />
          <span class="hero-mix-meter meter"
            ><span></span><span></span><span></span></span
          >
        </span>
        {m.hero_try()}
      </a>
      <a href="#download" class="btn btn-secondary btn-large">
        <Icon icon={Download04Icon} size={17} />
        {m.hero_download()}
      </a>
    </div>

    <p class="hero-meta">
      <Message
        parts={m.hero_meta.parts({})}
        tags={{
          link: { as: "a", href: repoUrl, target: "_blank", rel: "noopener" },
        }}
      />
    </p>

    <div class="hero-shot">
      {
        shots.map((s) => (
          <picture class={`hero-shot-${s.theme}`}>
            <source type="image/avif" srcset={s.avif} sizes={sizes} />
            <source type="image/webp" srcset={s.webp} sizes={sizes} />
            <img
              src={s.fallback.src}
              width={s.fallback.attributes.width}
              height={s.fallback.attributes.height}
              alt={m.hero_screenshot_alt()}
              loading="lazy"
              decoding="async"
            />
          </picture>
        ))
      }
    </div>
    {
      /* The shown theme's picture is the hero's largest paint, so it loads at
        once and first; the hidden one stays lazy, so it's never fetched unless
        the theme toggle shows it. Phones show neither, and lazy, neither is
        fetched there. data-theme is set before paint by ThemeBootstrap. */
    }
    <script is:inline>
      {
        const img = document.querySelector(
          ".hero-shot-" + document.documentElement.dataset.theme + " img"
        )
        if (img && !matchMedia("(max-width: 560px)").matches) {
          img.fetchPriority = "high"
          img.loading = "eager"
        }
      }
    </script>
  </div>
</header>

<style>
  /* An app page, not a pitch: the mark identifies the thing, the name is the
     heading, one line says what it does, and a screenshot shows the real
     mixer. No decorative gradients, and no device frame around it. */
  /* Tight enough that most of the screenshot is above a laptop's fold, and
     cut by it, so the page visibly goes on. */
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(32px, 4vw, 48px) clamp(48px, 8vw, 80px);
  }

  .hero-title {
    margin: 18px 0 0;
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-neutral-foreground-2);
    max-width: 60ch;
    margin: 14px 0 0;
    /* balance, not pretty: a short centred block wants even line lengths.
       pretty only protects the last line, which leaves the ones above it
       running full width against a centred axis. */
    text-wrap: balance;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 28px;
  }

  /* The page's one loud control, in the app's own terms: the sheen its filled
     buttons carry, a highlight along the top edge and a shadow in the button's
     own amber. Hovered, the play triangle becomes the level meter a playing
     card shows, which is what pressing it starts. */
  .hero-mix {
    background-image: linear-gradient(
      135deg,
      oklch(from var(--color-brand-fill) l c h / 0) 20%,
      oklch(
        from var(--color-brand-fill) calc(l + 0.04) calc(c + 0.03)
          calc(h - 25) / 0.9
      )
    );
    position: relative;
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.24),
      0 1px 2px oklch(from var(--color-brand-fill) calc(l - 0.35) c h / 0.35),
      0 8px 20px -8px oklch(from var(--color-brand-fill) l c h / 0.6);
    transition:
      background-color 150ms ease,
      transform 160ms var(--curve-decelerate-mid);
  }

  /* The hover shadow, faded in by opacity rather than by transitioning
     box-shadow, which would repaint the button every frame. An outer shadow
     is never drawn under its own box, so this one sits behind nothing. */
  .hero-mix::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 12px 28px -10px
      oklch(from var(--color-brand-fill) l c h / 0.7);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--curve-decelerate-mid);
  }

  .hero-mix:active {
    transform: scale(0.97);
    transition-duration: 100ms;
  }

  .hero-mix-icon {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
  }

  /* Each icon blurs as it goes and sharpens as it comes, so the swap reads
     as one icon changing rather than two crossing. */
  .hero-mix-icon > :global(*) {
    grid-area: 1 / 1;
    transition:
      opacity 150ms ease,
      filter 150ms ease,
      transform 200ms var(--curve-decelerate-mid);
  }

  /* The app's own meter (meter.css), held still until it's shown. */
  .hero-mix-meter {
    opacity: 0;
    filter: blur(2px);
    transform: scale(0.9);
  }

  .hero-mix-meter > span {
    animation-play-state: paused;
  }

  /* From the keyboard on every device; from a pointer only where hover is
     real, since a tap leaves a hover behind that would keep the meter going
     when the page comes back from history. */
  .hero-mix:focus-visible .hero-mix-icon > :global(svg) {
    opacity: 0;
    filter: blur(2px);
    transform: scale(0.9);
  }

  .hero-mix:focus-visible .hero-mix-meter {
    opacity: 1;
    filter: none;
    transform: scale(1);
  }

  .hero-mix:focus-visible .hero-mix-meter > span {
    animation-play-state: running;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-mix:hover {
      transform: translateY(-1px);
    }

    .hero-mix:hover::after {
      opacity: 1;
    }

    .hero-mix:hover:active {
      transform: scale(0.97);
    }

    .hero-mix:hover:active::after {
      opacity: 0;
      transition-duration: 100ms;
    }

    .hero-mix:hover .hero-mix-icon > :global(svg) {
      opacity: 0;
      filter: blur(2px);
      transform: scale(0.9);
    }

    .hero-mix:hover .hero-mix-meter {
      opacity: 1;
      filter: none;
      transform: scale(1);
    }

    .hero-mix:hover .hero-mix-meter > span {
      animation-play-state: running;
    }
  }

  /* Reduced motion keeps the swap as a fade; meter.css holds the bars. */
  @media (prefers-reduced-motion: reduce) {
    .hero-mix,
    .hero-mix:hover,
    .hero-mix:active,
    .hero-mix:hover:active,
    .hero-mix-icon > :global(*) {
      transform: none !important;
    }
  }

  .hero-meta {
    font-size: 14px;
    color: var(--color-neutral-foreground-3);
    margin-top: var(--space-mn);
  }

  /* The licence links to the code it covers. Underlined, since the line's
     colour alone wouldn't mark it. */
  .hero-meta :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 50%, transparent);
    text-underline-offset: 3px;
  }

  .hero-meta :global(a:hover) {
    color: var(--color-neutral-foreground-1);
  }

  /* The theme's own shot; the other is hidden and, being lazy, never fetched. */
  .hero-shot {
    width: 100%;
    max-width: 960px;
    margin-top: 40px;
  }

  @media (min-width: 1440px) {
    .hero-shot {
      max-width: 1080px;
    }
  }

  /* The top half only: the playing mix's header, the mixes and the first
     rows of sounds, fading out where it's cut so the cut reads as meant. */
  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 5;
    object-fit: cover;
    object-position: top;
    border: var(--stroke-width-thin) solid var(--color-neutral-stroke-1);
    border-bottom: 0;
    border-radius: var(--border-radius-large) var(--border-radius-large) 0 0;
    mask-image: linear-gradient(#000 55%, transparent);
  }

  :global([data-theme="dark"]) .hero-shot-light,
  :global([data-theme="light"]) .hero-shot-dark {
    display: none;
  }

  /* Phones show no screenshot: at their width the mixer's labels would be a
     few pixels tall. */
  @media (max-width: 560px) {
    .hero-ctas {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .hero-shot {
      display: none;
    }
  }
</style>
