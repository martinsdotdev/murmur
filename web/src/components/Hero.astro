---
import BrandLogo from "./BrandLogo.astro"
import Icon from "./Icon.astro"
import { Download04Icon, PlayIcon } from "@hugeicons/core-free-icons"

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<header class="hero" id="top" aria-labelledby="hero-heading">
  <div class="hero-inner container">
    <BrandLogo size={72} />

    <h1 id="hero-heading" class="serif-display hero-title">Murmur</h1>

    <p class="hero-sub">
      Play ambient sounds while you work, read, or fall asleep. Layer rain over
      a fireplace, and save the blend.
    </p>

    <div class="hero-ctas">
      <a href="#download" class="btn btn-primary btn-large hero-download">
        <Icon icon={Download04Icon} size={17} />
        Download for Windows
      </a>
      <a href={`${baseUrl}/app`} class="btn btn-secondary btn-large hero-try">
        <Icon icon={PlayIcon} size={17} />
        Mix in the browser
      </a>
    </div>

    <p class="hero-meta">Free · GPLv3 · No telemetry · Windows 10 and 11</p>
  </div>
</header>

<style>
  /* An app page, not a pitch: the mark identifies the thing, the name is the
     heading, and one line says what it does. No decorative gradients, and no
     drawn approximation of a window the visitor can open for real from here. */
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(56px, 9vw, 96px) clamp(48px, 8vw, 80px);
  }

  .hero-title {
    margin: 22px 0 0;
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-neutral-foreground-2);
    max-width: 46ch;
    margin: 14px 0 0;
    /* balance, not pretty: a short centred block wants even line lengths.
       pretty only protects the last line, which leaves the ones above it
       running full width against a centred axis. */
    text-wrap: balance;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 30px;
  }

  .hero-meta {
    font-size: 12.5px;
    color: var(--color-neutral-foreground-3);
    margin-top: 22px;
  }

  /* A phone can't install a Windows app, so there trying it in the browser
     leads: first, and in the primary style the download gives up. 720px is
     where the nav's "Try it" link goes, which would otherwise leave this the
     only way into the app, and a secondary one. */
  @media (max-width: 720px) {
    .hero-try {
      order: -1;
      background-color: var(--color-brand-background);
      color: var(--color-neutral-foreground-on-brand);
      border-color: transparent;
      box-shadow: var(--shadow-2);
    }

    .hero-download {
      background-color: var(--color-neutral-background-2);
      color: var(--color-neutral-foreground-1);
      border-color: var(--color-neutral-stroke-1);
      box-shadow: none;
    }
  }

  @media (max-width: 560px) {
    .hero-ctas {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
