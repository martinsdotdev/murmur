---
import { features } from "../data/features.ts"
import Icon from "./Icon.astro"
import { m } from "@/paraglide/messages.js"
---

<section class="features" id="features" aria-labelledby="features-heading">
  <div class="container">
    <h2 id="features-heading" class="section-h2 features-heading">
      {m.features_heading()}
    </h2>
    <p class="features-sub">{m.features_sub()}</p>

    <div class="features-grid">
      {
        features.map((f) => (
          <article class="card">
            <div class="card-icon">
              <Icon icon={f.icon} size={21} />
            </div>
            <div class="card-text">
              <h3 class="card-title">{f.title}</h3>
              <p class="card-sub">{f.sub}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    border-top: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
  }

  .features-sub {
    font-size: 15px;
    color: var(--color-neutral-foreground-2);
    max-width: 52ch;
    margin-bottom: var(--space-xxl);
  }

  .features-grid {
    display: grid;
    /* min() so a 320px screen, 280px inside the padding, gets one column that
       fits rather than a 300px one clipped at the edge. */
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-m);
  }

  .card {
    display: flex;
    align-items: center;
    gap: var(--space-mn);
    padding: 18px 20px;
    background: var(--color-neutral-background-2);
    border: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
    border-radius: var(--border-radius-large);
  }

  .card-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--color-neutral-background-3);
    border: var(--stroke-width-thin) solid var(--color-neutral-stroke-2);
    color: var(--color-brand-foreground);
  }

  .card-text {
    min-width: 0;
  }

  .card-title {
    font-family: var(--font-family-base);
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0;
    margin: 0;
  }

  .card-sub {
    /* The page's main explanation of the app, so body size, not caption. */
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-neutral-foreground-3);
    margin-top: 2px;
  }
</style>
