---
import "../styles/global.css"
import ThemeBootstrap from "../components/ThemeBootstrap.astro"
import ThemeToggle from "../components/ThemeToggle.astro"
import BrandLogo from "../components/BrandLogo.astro"
import Icon from "../components/Icon.astro"
import { GithubIcon } from "@hugeicons/core-free-icons"
import Footer from "../components/Footer.astro"
import { releasesUrl, repoUrl } from "../data/site.ts"
import { latestRelease } from "../data/release.ts"
import { m } from "@/paraglide/messages.js"
import {
  baseLocale,
  getLocale,
  locales,
  type Locale,
} from "@/paraglide/runtime.js"
import { aboutPath } from "@/lib/i18n"

interface Props {
  title?: string
  description?: string
}

const { title = m.site_title(), description = m.site_description() } =
  Astro.props

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "")
const locale = getLocale()
// Every language's copy of this page, for search engines to offer the right
// one. x-default is where someone whose language isn't here should land.
const alternate = (l: Locale) => new URL(aboutPath(l), Astro.site).href

// Open Graph wants a territory: en_US, not en.
const OG_LOCALE: Record<Locale, string> = {
  en: "en_US",
  "pt-BR": "pt_BR",
  es: "es_ES",
  ja: "ja_JP",
}
// The social card, one per language, taken by scripts/screenshots.mjs.
const card = new URL(`/og/${locale}.png`, Astro.site).href

// What the page describes, for search engines. No rating: there is none to
// give, and a made-up one is what gets a page penalised.
const release = await latestRelease
const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Murmur",
  description,
  url: alternate(locale),
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows 10, Windows 11, web browser",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  downloadUrl: release?.url ?? releasesUrl,
  ...(release && { softwareVersion: release.version }),
  inLanguage: locales,
}
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Murmur" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={alternate(locale)} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={m.hero_screenshot_alt()} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => (
          <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
        ))
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/icon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${baseUrl}/favicon.ico`} />
    <link rel="canonical" href={alternate(locale)} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={alternate(l)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternate(baseLocale)} />
    <script type="application/ld+json" set:html={JSON.stringify(app)} />

    {
      /* The landing page's own surface, which is not the app's. See the same
        block in AppLayout.astro. */
    }
    <meta
      name="theme-color"
      content="#1a1815"
      data-light="#faf6ee"
      data-dark="#1a1815"
    />

    <title>{title}</title>

    <ThemeBootstrap />
  </head>

  <body>
    {
      /* Acrylic command bar: blur+tint per Fluent 2 acrylic-on-transient guidance.
        The nav is always visible so it's the closest analogue to a Windows
        TitleBar with acrylic backdrop. */
    }
    <header class="commandbar">
      <div class="commandbar-grid container">
        <a
          href={`${baseUrl}${aboutPath(locale)}`}
          class="wordmark"
          aria-label={m.nav_home()}
        >
          <BrandLogo size={28} />
          <span class="wordmark-text">Murmur</span>
        </a>
        <nav class="nav-links" aria-label={m.nav_primary()}>
          <a href={`${baseUrl}/`}>{m.nav_try()}</a>
          <a href="#features">{m.nav_features()}</a>
          <a href="#download">{m.nav_download()}</a>
        </nav>
        <div class="nav-actions">
          <a
            href={repoUrl}
            class="nav-icon"
            aria-label={m.nav_source()}
            target="_blank"
            rel="noopener"
          >
            <Icon icon={GithubIcon} size={16} />
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer />

    <style>
      .commandbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--color-neutral-background-1); /* Solid fallback */
        background: var(--acrylic-tint);
        backdrop-filter: blur(40px) saturate(125%);
        -webkit-backdrop-filter: blur(40px) saturate(125%);
        border-bottom: var(--stroke-width-thin) solid
          var(--color-neutral-stroke-2);
      }

      .commandbar-grid {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: var(--space-xl);
        min-height: 60px;
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: var(--space-m);
        color: var(--color-neutral-foreground-1);
        /* The mark is a target, not a passage of text. Dragging across the
           command bar should not leave "Murmur" highlighted. */
        -webkit-user-select: none;
        user-select: none;
        /* Padded into a hit area, then pulled back by the same amount so the
           mark stays optically flush with the container edge. */
        padding: 5px 8px;
        margin-left: -8px;
        border-radius: var(--border-radius-small);
        transition: background-color var(--duration-faster)
          var(--curve-easy-ease);
      }

      /* Overrides the global a:hover, which would tint the wordmark brand and
         underline it. It takes the same subtle fill as the rest of the bar. */
      .wordmark:hover {
        color: var(--color-neutral-foreground-1);
        text-decoration: none;
        background-color: var(--color-subtle-background-hover);
      }

      .wordmark:active {
        background-color: var(--color-subtle-background-pressed);
      }

      .wordmark-text {
        font-family: var(--font-family-serif);
        font-weight: var(--font-weight-regular);
        font-size: 19px;
        line-height: 1;
      }

      /* Right-aligned, so the links sit with the icon actions as one group. */
      .nav-links {
        display: flex;
        justify-content: flex-end;
        gap: var(--space-s);
      }

      .nav-links a {
        height: 32px;
        display: inline-flex;
        align-items: center;
        padding: 0 var(--space-m);
        color: var(--color-neutral-foreground-2);
        font-size: var(--font-body1-size);
        font-weight: var(--font-weight-regular);
        border-radius: var(--border-radius-small);
        transition:
          background-color var(--duration-faster) var(--curve-easy-ease),
          color var(--duration-faster) var(--curve-easy-ease);
      }

      .nav-links a:hover {
        background-color: var(--color-subtle-background-hover);
        color: var(--color-neutral-foreground-1);
        text-decoration: none;
      }

      /* The mirror of the wordmark's pull-back: each icon is centred in a 32px
         target, so the last one is pulled out by its 8px of inset and its
         glyph lines up with the container edge. */
      .nav-actions {
        /* Pinned to the last column: on a phone the links are hidden, and
           auto-placement would otherwise drop the icons into the middle one. */
        grid-column: 3;
        display: inline-flex;
        align-items: center;
        gap: var(--space-xs);
        margin-right: -8px;
      }

      .nav-icon {
        width: 32px;
        height: 32px;
        display: inline-grid;
        place-items: center;
        border-radius: var(--border-radius-small);
        color: var(--color-neutral-foreground-2);
        transition:
          background-color var(--duration-faster) var(--curve-easy-ease),
          color var(--duration-faster) var(--curve-easy-ease);
      }

      .nav-icon:hover {
        background-color: var(--color-subtle-background-hover);
        color: var(--color-neutral-foreground-1);
        text-decoration: none;
      }

      @media (max-width: 720px) {
        .nav-links {
          display: none;
        }
      }
    </style>
  </body>
</html>
